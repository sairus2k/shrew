  "query": "\n        UPDATE sync_queue SET status = 'in_progress'\n        WHERE id = (\n            SELECT id FROM sync_queue\n            WHERE status IN ('pending', 'in_progress')\n            ORDER BY id\n            LIMIT 1\n        )\n        RETURNING id AS \"id!\", entity_type, issue_key AS \"issue_key: IssueKey\",\n                  payload, retry_count\n        ",
